<Project Sdk="Microsoft.NET.Sdk">
  <!-- La aplicacion de escritorio: interfaz (Avalonia) e integracion con
       Windows. La logica vive en NovaFolder.Core. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>NovaFolder</AssemblyName>
    <RootNamespace>NovaFolder</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\NovaFolder.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <!-- Solo Windows: usa COM, el registro y el shell. Core sigue siendo multiplataforma. -->
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="..\..\assets\NovaFolder.ico" Link="Assets\NovaFolder.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NovaFolder.Core\NovaFolder.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="System.Drawing.Common" />
    <PackageReference Include="Velopack" />
  </ItemGroup>
</Project>
