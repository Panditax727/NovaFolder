<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NovaFolder.Views.MainWindow"
        Title="NovaFolder"
        Icon="avares://NovaFolder/Assets/NovaFolder.ico"
        Width="1060" Height="700"
        MinWidth="780" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="#15151D">

    <!-- La ventana de la aplicación: navegación a la izquierda y la página
         elegida a la derecha. Cerrarla la oculta: NovaFolder sigue en la
         bandeja para que funcionen las carpetas del Escritorio. -->
    <Grid ColumnDefinitions="236,*">

        <!-- ===== Barra lateral ===== -->
        <Border Background="#0AFFFFFF" BorderBrush="#12FFFFFF" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,18,14,14">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="10" Margin="8,0,0,22">
                    <Image Source="avares://NovaFolder/Assets/NovaFolder.ico" Width="32" Height="32"
                           RenderOptions.BitmapInterpolationMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="NovaFolder" Classes="h2"/>
                        <TextBlock Text="Tu Escritorio, ordenado" Classes="suave" FontSize="11"/>
                    </StackPanel>
                </StackPanel>

                <!-- Pie: versión y actualización -->
                <StackPanel DockPanel.Dock="Bottom" Spacing="8">
                    <Border Name="BannerActualizacion" IsVisible="False" CornerRadius="10" Padding="12,10"
                            Background="{StaticResource NovaAcentoSuave}">
                        <StackPanel Spacing="8">
                            <TextBlock Name="TextoActualizacion" Classes="texto" FontSize="12"/>
                            <Button Name="BotonReiniciar" Classes="primario" Content="Reiniciar y actualizar"
                                    HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="10,6"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Name="Version" Classes="suave" FontSize="11" Margin="8,0,0,0"/>
                </StackPanel>

                <ListBox Name="Navegacion" Classes="nav" SelectionMode="Single,AlwaysSelected"/>
            </DockPanel>
        </Border>

        <!-- ===== Contenido ===== -->
        <Panel Grid.Column="1">
            <ContentControl Name="Pagina" Margin="32,26,32,24"/>

            <!-- Barra de avisos, abajo al centro -->
            <Border Name="BarraAviso" IsVisible="False"
                    VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="24"
                    MaxWidth="620" Padding="16,8,8,8" CornerRadius="10"
                    Background="#F02A2A38" BorderBrush="#26FFFFFF" BorderThickness="1"
                    BoxShadow="0 8 24 0 #66000000">
                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                    <TextBlock Name="GlifoAviso" Classes="glifo" Text="&#xE73E;" Margin="0,0,10,0"/>
                    <TextBlock Name="TextoAviso" Grid.Column="1" Classes="texto" VerticalAlignment="Center"/>
                    <Button Name="BotonAccionAviso" Grid.Column="2" Classes="nova-enlace" Margin="12,0,0,0"/>
                    <Button Name="BotonCerrarAviso" Grid.Column="3" Classes="nova-icono" Content="&#xE711;" FontSize="10"/>
                </Grid>
            </Border>
        </Panel>
    </Grid>
</Window>
