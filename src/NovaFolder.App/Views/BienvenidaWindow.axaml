<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NovaFolder.Views.BienvenidaWindow"
        Title="Bienvenido a NovaFolder"
        Width="520"
        SizeToContent="Height"
        CanResize="False"
        WindowDecorations="None"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        Icon="avares://NovaFolder/Assets/NovaFolder.ico">

    <!-- Recorrido de primera vez. Cada paso es un panel; el code-behind
         muestra uno a la vez. Se puede volver a ver desde "Cómo se usa". -->
    <Border Classes="nova-superficie" CornerRadius="14" Padding="0">
        <DockPanel>
            <!-- Barra superior: arrastrable, con cerrar -->
            <Grid Name="Barra" DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Background="Transparent" Margin="18,10,8,0">
                <TextBlock Text="NovaFolder" Classes="suave" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <Button Name="BotonCerrar" Grid.Column="1" Classes="nova-icono" Content="&#xE711;" ToolTip.Tip="Cerrar"/>
            </Grid>

            <!-- Navegación -->
            <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto,*" Margin="24,8,24,22">
                <Button Name="BotonAtras" Classes="nova-enlace" Content="Atrás" HorizontalAlignment="Left"/>
                <StackPanel Name="Puntos" Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"/>
                <Button Name="BotonSiguiente" Grid.Column="2" Classes="nova-accion"
                        Background="{StaticResource NovaAcento}" HorizontalAlignment="Right" MinWidth="110"
                        HorizontalContentAlignment="Center"/>
            </Grid>

            <Panel Margin="36,8,36,12" MinHeight="300">
                <!-- 1. Qué es -->
                <StackPanel Name="Paso1" Spacing="14" VerticalAlignment="Center">
                    <Image Source="avares://NovaFolder/Assets/NovaFolder.ico" Width="96" Height="96"
                           RenderOptions.BitmapInterpolationMode="HighQuality"/>
                    <TextBlock Text="Tu Escritorio, ordenado" Classes="titulo" FontSize="22" HorizontalAlignment="Center"/>
                    <TextBlock Classes="suave" FontSize="14" TextAlignment="Center" TextWrapping="Wrap" LineHeight="21"
                               Text="NovaFolder agrupa tus accesos directos, juegos y archivos en carpetas que se abren con un clic, como en el móvil."/>
                    <TextBlock Classes="pista" FontSize="12"
                               Text="Tus archivos nunca se borran: solo se ordenan."/>
                </StackPanel>

                <!-- 2. Crear y llenar -->
                <StackPanel Name="Paso2" Spacing="16" IsVisible="False">
                    <Border Width="64" Height="64" CornerRadius="32" Background="{StaticResource NovaAcentoSuave}" HorizontalAlignment="Center">
                        <TextBlock Classes="glifo" Text="&#xE8F4;" FontSize="28" Foreground="{StaticResource NovaTexto}" HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Crea carpetas y llénalas" Classes="titulo" FontSize="20" HorizontalAlignment="Center"/>
                    <StackPanel Name="Lista2" Spacing="12"/>
                </StackPanel>

                <!-- 3. Usar y organizar -->
                <StackPanel Name="Paso3" Spacing="16" IsVisible="False">
                    <Border Width="64" Height="64" CornerRadius="32" Background="{StaticResource NovaAcentoSuave}" HorizontalAlignment="Center">
                        <TextBlock Classes="glifo" Text="&#xE8A7;" FontSize="28" Foreground="{StaticResource NovaTexto}" HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Ábrelas y organízalas" Classes="titulo" FontSize="20" HorizontalAlignment="Center"/>
                    <StackPanel Name="Lista3" Spacing="12"/>
                </StackPanel>

                <!-- 4. Preferencias -->
                <StackPanel Name="Paso4" Spacing="14" IsVisible="False">
                    <Border Width="64" Height="64" CornerRadius="32" Background="{StaticResource NovaAcentoSuave}" HorizontalAlignment="Center">
                        <TextBlock Classes="glifo" Text="&#xEA99;" FontSize="28" Foreground="{StaticResource NovaTexto}" HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Deja tu Escritorio limpio" Classes="titulo" FontSize="20" HorizontalAlignment="Center"/>

                    <Border Classes="nova-fila" Background="{StaticResource NovaHueco}" Padding="14,12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" Margin="0,0,12,0">
                                <TextBlock Text="Limpiar el Escritorio (recomendado)" Foreground="{StaticResource NovaTexto}" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Classes="suave" FontSize="12" TextWrapping="Wrap"
                                           Text="Los accesos directos que metas en una carpeta salen del Escritorio. Si los quitas de la carpeta, vuelven solos."/>
                            </StackPanel>
                            <ToggleSwitch Name="InterruptorLimpiar" Grid.Column="1" Classes="compacto" IsChecked="True"/>
                        </Grid>
                    </Border>
                    <Border Classes="nova-fila" Background="{StaticResource NovaHueco}" Padding="14,12">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" Margin="0,0,12,0">
                                <TextBlock Text="Iniciar con Windows" Foreground="{StaticResource NovaTexto}" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Classes="suave" FontSize="12" TextWrapping="Wrap"
                                           Text="Tus carpetas estarán listas cada vez que enciendas el equipo."/>
                            </StackPanel>
                            <ToggleSwitch Name="InterruptorInicio" Grid.Column="1" Classes="compacto" IsChecked="True"/>
                        </Grid>
                    </Border>
                    <TextBlock Classes="pista" Text="Puedes cambiarlo cuando quieras desde el ícono de NovaFolder junto al reloj."/>
                </StackPanel>
            </Panel>
        </DockPanel>
    </Border>
</Window>
