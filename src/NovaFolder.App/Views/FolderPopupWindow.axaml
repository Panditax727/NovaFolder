<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NovaFolder.Views.FolderPopupWindow"
        Title="NovaFolder"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        WindowDecorations="None"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        Background="Transparent"
        Topmost="True">

    <!-- La tarjeta ES la ventana entera: nace un poco más pequeña y
         transparente, y crece hasta su tamaño (ver OnOpened). -->
    <Border Name="Tarjeta"
            Classes="nova-superficie"
            Padding="12"
            Opacity="0"
            RenderTransform="scale(0.94)"
            RenderTransformOrigin="0%,0%">
        <Border.Transitions>
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.14"/>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18">
                    <TransformOperationsTransition.Easing>
                        <CubicEaseOut/>
                    </TransformOperationsTransition.Easing>
                </TransformOperationsTransition>
            </Transitions>
        </Border.Transitions>

        <DockPanel Name="Raiz">
            <!-- Encabezado: nombre (clic para renombrar) y acciones -->
            <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="4,0,0,8">
                <Panel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Name="Titulo"
                               Classes="titulo"
                               Cursor="IBeam"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               ToolTip.Tip="Clic para cambiar el nombre"/>
                    <TextBox Name="EditorTitulo"
                             IsVisible="False"
                             FontSize="15"
                             FontWeight="SemiBold"
                             MaxLength="60"
                             Padding="6,3"
                             MinHeight="0"
                             VerticalAlignment="Center"/>
                </Panel>
                <Button Name="BotonAgregar" Grid.Column="1" Classes="nova-icono"
                        Content="&#xE710;" ToolTip.Tip="Agregar elementos (Ctrl+O)"/>
                <Button Name="BotonMas" Grid.Column="2" Classes="nova-icono"
                        Content="&#xE712;" ToolTip.Tip="Más opciones"/>
            </Grid>

            <!-- Filtro: solo aparece cuando la carpeta ya es grande -->
            <TextBox Name="Buscador"
                     DockPanel.Dock="Top"
                     IsVisible="False"
                     PlaceholderText="Buscar en la carpeta…"
                     Margin="0,0,0,8"/>

            <!-- Recordatorio discreto de los gestos: así se descubren sin manual -->
            <TextBlock Name="Ayuda"
                       DockPanel.Dock="Bottom"
                       Classes="pista"
                       Text="Arrastra para ordenar, o al Escritorio para sacarlo"
                       ToolTip.Tip="Clic derecho sobre un elemento para más opciones"
                       Margin="0,10,0,0"/>

            <TextBlock Name="Aviso"
                       DockPanel.Dock="Bottom"
                       Classes="error"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       IsVisible="False"
                       Margin="0,8,0,0"/>

            <!-- Rejilla de elementos: la misma que usa la ventana principal -->
            <ContentControl Name="Contenido"/>
        </DockPanel>
    </Border>
</Window>
