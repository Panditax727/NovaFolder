<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NovaFolder.Views.Paginas.AyudaPagina">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="16" MaxWidth="820" HorizontalAlignment="Left" Margin="0,0,18,0">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4">
                    <TextBlock Text="Cómo se usa" Classes="h1"/>
                    <TextBlock Text="Todo lo que puedes hacer con NovaFolder, de un vistazo." Classes="suave" FontSize="13"/>
                </StackPanel>
                <Button Name="BotonGuia" Grid.Column="1" Classes="primario" VerticalAlignment="Center" Content="Ver la guía de bienvenida"/>
            </Grid>

            <!-- Consejos: se rellenan desde el code-behind -->
            <UniformGrid Name="Consejos" Columns="2"/>

            <TextBlock Text="PREGUNTAS FRECUENTES" Classes="seccion" Margin="4,10,0,0"/>
            <StackPanel Name="Preguntas" Spacing="8"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
