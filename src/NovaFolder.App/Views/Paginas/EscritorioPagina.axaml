<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NovaFolder.Views.Paginas.EscritorioPagina">

    <DockPanel>
        <!-- Cabecera -->
        <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,20">
            <TextBlock Text="Ordenar el Escritorio" Classes="h1"/>
            <TextBlock Classes="suave" FontSize="13" TextWrapping="Wrap"
                       Text="NovaFolder revisa tu Escritorio y sugiere una carpeta para cada cosa. Revisa las sugerencias y guárdalo todo con un clic."/>
        </StackPanel>

        <!-- Resumen -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,16,*,16,1.4*" Margin="0,0,0,16">
            <Border Classes="tarjeta">
                <StackPanel Spacing="2">
                    <TextBlock Name="CantidadSueltos" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource NovaTexto}"/>
                    <TextBlock Text="sueltos en el Escritorio" Classes="suave"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Classes="tarjeta">
                <StackPanel Spacing="2">
                    <TextBlock Name="CantidadGuardados" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource NovaAcento}"/>
                    <TextBlock Text="ya ordenados en carpetas" Classes="suave"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Classes="tarjeta">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="Quitar del Escritorio lo que ordenes" Classes="texto" FontWeight="SemiBold"/>
                        <TextBlock Classes="suave" FontSize="12" TextWrapping="Wrap"
                                   Text="Los accesos directos salen del Escritorio y vuelven si los quitas de la carpeta."/>
                    </StackPanel>
                    <ToggleSwitch Name="InterruptorLimpiar" Grid.Column="1" Classes="compacto"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Acciones -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,12">
            <TextBlock Name="Estado" Classes="suave" VerticalAlignment="Center" TextWrapping="Wrap"/>
            <Button Name="BotonRevisar" Grid.Column="1" Classes="secundario" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Classes="glifo" Text="&#xE72C;" FontSize="13"/>
                    <TextBlock Text="Volver a revisar"/>
                </StackPanel>
            </Button>
            <Button Name="BotonOrganizar" Grid.Column="2" Classes="primario">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Classes="glifo" Text="&#xEA99;" Foreground="White" FontSize="14"/>
                    <TextBlock Name="TextoOrganizar" Text="Ordenar todo"/>
                </StackPanel>
            </Button>
        </Grid>

        <Panel>
            <!-- Lista de lo que está suelto, agrupado por la carpeta sugerida -->
            <Border Name="MarcoLista" Classes="tarjeta" Padding="8">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Name="Lista" Spacing="2"/>
                </ScrollViewer>
            </Border>

            <!-- Todo en orden -->
            <Border Name="Ordenado" Classes="tarjeta" IsVisible="False" Padding="40">
                <StackPanel Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Border Width="72" Height="72" CornerRadius="36" Background="{StaticResource NovaAcentoSuave}" HorizontalAlignment="Center">
                        <TextBlock Classes="glifo" Text="&#xE73E;" FontSize="30" Foreground="White" HorizontalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Tu Escritorio está en orden" Classes="h2" HorizontalAlignment="Center"/>
                    <TextBlock Classes="suave" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="380"
                               Text="No queda nada suelto. Lo que dejes en el Escritorio aparecerá aquí la próxima vez."/>
                    <Button Name="BotonVerCarpetas" Classes="secundario" Content="Ver mis carpetas" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Panel>
    </DockPanel>
</UserControl>
