<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="android_folder_win11.MainWindow"
        Title="NovaFolder"
        Width="820" Height="540"
        MinWidth="420" MinHeight="300"
        WindowStartupLocation="CenterScreen"
        Background="Transparent">

    <!-- Panel de respaldo: si el sistema no da Mica ni acrílico (Linux, o
         Windows 10), este degradado evita que la ventana se vea transparente
         y con el texto ilegible sobre el escritorio. -->
    <Panel>
        <Border Name="FondoRespaldo" IsVisible="False">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                    <GradientStop Color="#1E1E2E" Offset="0"/>
                    <GradientStop Color="#26263A" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      Margin="0,30,0,0">
            <WrapPanel Name="FoldersPanel" Orientation="Horizontal" Margin="18"/>
        </ScrollViewer>

        <TextBlock Name="Encabezado"
                   Text="NovaFolder"
                   FontSize="12" FontWeight="SemiBold"
                   Foreground="#B8C0D0" Opacity="0.75"
                   Margin="18,10,0,0"
                   VerticalAlignment="Top" HorizontalAlignment="Left"
                   IsHitTestVisible="False"/>
    </Panel>
</Window>
